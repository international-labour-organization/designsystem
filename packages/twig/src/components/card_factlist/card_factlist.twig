{# card_factlist.twig #}
{% set size = size|default("narrow") %}
{% set theme = theme|default("dark") %}

<div class="ilo--card ilo--card__type__factlist ilo--card__size__{{size}} ilo--card__theme__{{theme}}">
	<div class="ilo--card--wrap">
		<div class="ilo--card--content">
			{% if title %}
				<{{titleLevel|default('p')}} class="ilo--card--title">{{ title }}</{{titleLevel|default('p')}}>
			{% endif %}
			{% if list %}
				{% include "@components/list/list.twig" with {
          ordered: "unordered",
          items: list.items,
          prefix: prefix,
					theme: theme
        } only %}
			{% endif %}
		</div>
	</div>
</div>
