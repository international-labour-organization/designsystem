{# card_detail.twig #}

{% set theme = theme|default("light") %}
{% set size = size|default("narrow") %}
{% set iconColor = theme == "light" ? "var(--ilo-color-light-icon-default)" : "var(--ilo-color-dark-icon-default)" %}

<div class="ilo--card ilo--card__type__detail ilo--card__size__{{size}} {% if isvideo|boolval %} ilo--card__isvideo {% endif %} ilo--card__theme__{{theme}}">
	<a class="ilo--card--link" href="{{link}}" title="{{title}}">
		<span class="ilo--card--link--text">{{title}}</span>
	</a>
	<div class="ilo--card--wrap">
		{% if image %}
			<div class="ilo--card--image--wrapper">
				{% include "@components/picture/picture.twig" with {
          image: image,
          class: "card"
        }
      %}
			</div>
		{% endif %}
		<div class="ilo--card--content">
			{% if eyebrow %}
				<p class="ilo--card--eyebrow">{{eyebrow}}</p>
			{% endif %}
			{% if title %}
				<{{titleLevel|default('p')}} class="ilo--card--title">{{ title }}</{{titleLevel|default('p')}}>
			{% endif %}
			{% if intro %}
				<p class="ilo--card--intro">{{intro}}</p>
			{% endif %}
			{% if date and not dateExtra %}
				<time class="ilo--card--date" datetime="{{date.unix}}">{{date.human}}</time>
			{% endif %}
			{% if dateExtra %}
				<p class="ilo--card--date-extra">
					{% include "@components/icon/icon.twig" with {
						name: "triangle_right",
						size: 20,
						color: iconColor,
						class: prefix ~ "--card--icon-right"
					} %}
					{% include "@components/icon/icon.twig" with {
						name: "triangle_left",
						size: 20,
						color: iconColor,
						class: prefix ~ "--card--icon-left"
					} %}
					{{dateExtra}}
				</p>
			{% endif %}
		</div>
	</div>
</div>
