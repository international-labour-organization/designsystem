{#
  HEROCARD COMPONENT
#}
{% set theme = theme|default("dark") %}
{% set background = background|default("solid") %}
{% set cornercut = cornercut ?? true %}

<div class="ilo--hero-card ilo--hero-card__theme__{{ theme }} ilo--hero-card__background__{{ background }} {% if cornercut|boolval %} ilo--hero-card__cornercut {% endif %}">
  {% if eyebrow %}
    <p class="{{ prefix }}--hero-card--eyebrow">{{ eyebrow }}</p>
  {% endif %}
  {% if title %}
    {% if url %}
      <a href={{ url }} class="{{ prefix }}--hero-card--title-link">
        <h1 class="{{ prefix }}--hero-card--title">{{ title }}</h1>
      </a>
    {% else %}
     <h1 class="{{ prefix }}--hero-card--title">{{ title }}</h2>
    {% endif %}
  {% endif %}
  {% if intro %}
    <p class="{{ prefix }}--hero-card--intro">{{ intro }}</p>
  {% endif %}
  {% if datecopy %}
    <p class="{{ prefix }}--hero-card--datecopy">{{ datecopy }}</p>
  {% endif %}
  {% if socialmedia %}
    {% include "@components/socialmedia/socialmedia.twig" with {
      theme: theme,
      align: "start",
      icons: socialmedia.icons
  } %}
  {% endif %}
</div>
