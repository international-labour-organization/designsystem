{#
  LINK LIST COMPONENT
#}
{% set titleLevel = titleLevel|default('h3') %}
{% set theme = theme|default('light') %}

<div class="ilo--link-list ilo--link-list--{{theme}}" data-loadcomponent="LinkList">
  {% if headline %}
    <{{titleLevel}} class="ilo--link-list--headline">{{headline}}</{{titleLevel}}>
  {% endif %}
  <ul class="ilo--link-list--linkgroups">
    {% for group in linkgroup %}
    <li class="ilo--link-list--linkgroups-item">
      {% if group.headline is not empty %}
      <h4 class="ilo--link-list--links--headline">{{group.headline}}</h4>
      {% endif %}
      <ul class="ilo--link-list--links">
        {% for link in group.links %}
        <li class="ilo--link-list--links--item{{ link.indented|boolval ? ' indented'}}">
          <a href="{{link.url}}" class="ilo--link-list--link">
            <span class="ilo--link-list--label">{{link.label}}</span>
            <span class="ilo--link-list--icon"></span>
          </a>
        </li>
        {% endfor %}
      </ul>
    </li>
    {% endfor %}
  </ul>
</div>
