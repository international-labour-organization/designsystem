{# notification.twig #}

{% set placement = placement|default("dialog") %}
{% set type = type|default("info") %}

<div class="ilo--notification ilo--notification--{{placement}} icon icon--{{type}}" role="status" aria-live="polite" aria-relevant="additions" data-loadcomponent="Notification" data-prefix="ilo">
  <div class="ilo--notification--content">
    <h2 class="ilo--notification--headline">{{headline}}</h2>
    <p class="ilo--notification--copy">{{copy}}</p>
    {% if timestamp %}
      <time class="ilo--notification--date" datetime="{{timestamp.unix}}">{{timestamp.human}}</time>
    {% endif %}
    {% if cta %}
      {% include "@components/button/button.twig" with {
        prefix: prefix,
        size: "small",
        type: "secondary",
        label: cta.label,
        url: cta.url,
      } only %}
    {% endif %}
  </div>
  {% include "@components/button/button.twig" with {
    className: prefix ~ "--notification--close",
    prefix: prefix,
    size: "small",
    type: "secondary",
    label: closelabel,
    icononly: true,
    icon: {
      name: "close",
    },
  } only %}
</div>
