{# card_promo.twig #}

{# Set default size to standard #}
{% set size = size|default("standard") %}
{% set theme = theme|default("light") %}
{% set cornercut = cornercut ?? true %}


<div class="ilo--card--wrapper ilo--card--wrapper__type__promo ilo--card--wrapper__type__promo__size__{{ size }}">
	<div class="ilo--card ilo--card__type__promo ilo--card__size__{{ size }} ilo--card__theme__{{theme}} {% if cornercut|boolval %}ilo--card__cornercut{% endif %} {% if image %}ilo--card__hasimage{% endif %}">
		<a class="ilo--card--link" href="{{link}}" title="{{title}}">
			<span class="ilo--card--link--text">{{title}}</span>
		</a>
		<div class="ilo--card--wrap">
			{% if image %}
				<div class="ilo--card--image--wrapper">
					{% include "@components/picture/picture.twig" with {
              image: image,
              class: "card"
            } %}
				</div>
			{% endif %}
			<div class="ilo--card--content">
				{% if eyebrow %}
					<p class="ilo--card--eyebrow">{{eyebrow}}</p>
				{% endif %}
				{% if title %}
					<{{titleLevel|default('p')}} class="ilo--card--title">{{ title }}</{{titleLevel|default('p')}}>
				{% endif %}
				{% if intro %}
					<p class="ilo--card--intro">{{intro}}</p>
				{% endif %}
				{% if cta %}
					<div class="ilo--card--cta">
						{% include "@components/button/button.twig" with {
							size: "medium",
							url: cta.url,
							label: cta.label,
							type: "primary",
						} only %}
					</div>
				{% endif %}
			</div>
		</div>
	</div>
</div>
