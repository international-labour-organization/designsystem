{#
  TABLE COMPONENT
#}
<div class="ilo--table{% if zebra|boolval %} ilo--table--zebra{% endif %}{% if smallrows|boolval %} ilo--table--small{% endif %}" data-loadcomponent="Table">
  <header class="ilo--table--header">
    <h3 class="ilo--table--headline">
      {{headline}}
      {% if tooltip %}
        {% include '@components/tooltip/tooltip.twig' with tooltip %}
      {% endif %}
    </h3>
    {% if description is defined %}
    <p class="ilo--table--description">
      {{description}}
    </p>
    {% endif %}
  </header>
  <div class="ilo--table--wrapper">
    <table class="ilo--table--content">
      <thead class="ilo--table--head">
        <tr class="ilo--table--head--row">
        {% for column in tableheadings %}
          <th class="ilo--table--head--cell">{{column}}</th>
        {% endfor %}
        </tr>
      </thead>
      <tbody class="ilo--table--body">
        {% for row in tabledata %}
          <tr class="ilo--table--body--row">
            {% for cell in row %}
              {% set evaluate = cell|striptags|replace({'/': '', '-':'','_':'','.':'',}) %}
              <td class="ilo--table--body--cell{% if evaluate matches '/^[0-9]+$/' %} numeric{% endif %}">{{cell}}</td>
            {% endfor %}
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>
