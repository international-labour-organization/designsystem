{#
  VIDEO COMPONENT
#}
{% set theme = theme|default("light") %}
<figure class="ilo--video ilo--video__theme__{{theme}}" data-prefix="ilo">
  <div class="ilo--video--wrapper">
    {% include "@components/video/videoplayer.twig" with {
      alt: alt,
      controls: video.controls,
      prefix: prefix,
      src: video.src,
      tracks: video.tracks,
      url: url,
      vjsType: vjsType
    } %}
  </div>
  {% if caption %}
    <figcaption class="ilo--video--caption">{{caption}}</figcaption>
  {% endif %}
</figure>
