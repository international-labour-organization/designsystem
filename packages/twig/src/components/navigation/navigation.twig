{#
  NAVIGATION COMPONENT
#}


<header class="ilo--header" data-loadcomponent="Navigation" data-prefix="ilo">
	<div class="ilo--header--utility-bar">
		{% if languagecontextmenu.links is not empty %}
			<div class="ilo--language-switcher">
				<div class="ilo--language-switcher--wrap">
					<button tabindex="2" class="ilo--language-switcher--button" type="button">
						{{languagelabel}}
					</button>
					{% include '@components/contextmenu/contextmenu.twig' with {
            links: languagecontextmenu.links,
            prefix: prefix
          }
        %}
				</div>
				<!-- /.ilo--language-switcher--wrap -->
			</div>
			<!-- /.ilo--language-switcher -->
		{% endif %}
	</div>
	<!-- /.ilo--header--utility-bar -->
	<div class="ilo--header--logo-bar">
		<div class="ilo--header--inner {{ prefix }}--container">
			<a tabindex="1" href="{{siteurl}}" class="ilo--header--logo-link">
				<img class="ilo--header--logo" src="{{logo.image}}" alt="{{logo.alt}}">
			</a>
			<p class="ilo--header--logo-tagline">
				{{tagline.tag}}
				<span class="ilo--header--logo-tagline--small">{{tagline.small}}</span>
			</p>
			<button class="ilo--header--menu">{{menulabel}}</button>
		</div>
		<!-- /.ilo--header--inner -->
	</div>

	<!-- /.ilo--header--logo-bar -->
	<div class="ilo--header--navigation">
		<div
			class="ilo--header--inner {{ prefix }}--container">
			<!-- /.ilo--mobile--nav -->
			<div class="ilo--mobile--nav">
				<div class="ilo--mobile--nav--logo">
					<a href="{{siteurl}}" class="ilo--header--logo-link">
						<img class="ilo--header--logo" src="{{mobilelogo.image}}" alt="{{mobilelogo.alt}}">
					</a>
					<button class="ilo--header--menu--close">{{menucloselabel}}</button>
				</div>
				<!-- /.ilo--mobile--logo -->
				<div class="ilo--mobile--nav--search">
					{% block mobileSearch %}
						{% include '@components/form/form.twig' with {
            attributes: {
              action: searchfield.action,
              "aria-label": label,
              "data-search": "true",
            },
            fieldsets: [{
              fields: [{
                type: "search",
                placeholder: searchfield.input.placeholder,
                name: searchfield.input.name,
                id: searchfield.input.id,
              }]
            }]
          }
          %}
					{% endblock %}
				</div>
				<!-- /.ilo--mobile--search -->
				{% if languagecontextmenu.links is not empty %}
					<div class="ilo--mobile--nav--language--switcher">
						<button class="ilo--mobile--nav--language--switcher--button" type="button">{{languagelabel}}</button>
					</div>
				{% endif %}
				<!-- /.ilo--mobile--nav--language--switcher -->
				<div class="ilo--mobile--nav--language--select">
					<div class="ilo--header--inner {{ prefix }}--container">
						<div class="ilo--mobile--subnav--menu">
							<button class="ilo--mobile--subnav--back" type="button">{{subnav.mobilebacklabel}}</button>
							<button class="ilo--header--menu--close">{{subnav.mobilecloselabel}}</button>
							<h6 class="ilo--mobile--subnav--label">{{languagelabel}}</h6>
						</div>
						<!-- /ilo--mobile--subnav--menu -->
						<ul class="ilo--nav--set">
							{% for item in languagecontextmenu.links %}
								<li class="ilo--nav--items">
									<a href="{{item.url}}" class="ilo--nav--link ilo--nav--language">
										{{item.label}}
									</a>
								</li>
							{% endfor %}
						</ul>
					</div>
				</div>
			</div>
			<nav class="ilo--nav" aria-labelledby="primary-navigation">
				<h2 class="ilo--nav--label" id="primary-navigation">{{primarynav.navlabel}}</h2>
				<ul class="ilo--nav--set">
					{% for item in primarynav.items %}
						<li class="ilo--nav--items">
							<a href="{{item.link}}" class="ilo--nav--link">{{item.label}}</a>
						</li>
					{% endfor %}
					{% if subnav %}
						<li class="ilo--nav--items">
							<button class="ilo--nav--trigger">{{subnav.buttonlabel}}</button>
						</li>
					{% endif %}
				</ul>
			</nav>
			<div class="ilo--search">
				<button class="ilo--search--button" type="button">{{searchlabel}}</button>
			</div>
			<!-- /.ilo--search -->
		</div>
		<!-- /.ilo--header--inner -->
		{% if subnav %}
			<nav class="ilo--subnav" aria-labelledby="secondary-navigation">
				<div class="ilo--subnav--inner {{ prefix }}--container">
					<div class="ilo--mobile--subnav">
						<div class="ilo--mobile--subnav--menu">
							<button class="ilo--mobile--subnav--back" type="button">{{subnav.mobilebacklabel}}</button>
							<button class="ilo--header--menu--close">{{subnav.mobilecloselabel}}</button>
							<h6 class="ilo--mobile--subnav--label">{{subnav.buttonlabel}}</h6>
						</div>
						<!-- /ilo--mobile--subnav--menu -->
					</div>
					<!-- /.ilo--mobile--subnav -->
					<h2 class="ilo--nav--label" id="secondary-navigation">{{subnav.navlabel}}</h2>
					<ul class="ilo--subnav--set">
						{% for item in subnav.items %}
							<li class="ilo--subnav--items">
								<a href="{{item.link}}" class="ilo--subnav--link">{{item.label}}</a>
							</li>
						{% endfor %}
					</ul>
				</div>
				<!-- /.ilo--subnav--inner -->
			</nav>
		{% endif %}

		<div class="ilo--search-box">
			<div class="ilo--header--inner {{ prefix }}--container">
				{% block desktopSearch %}
					{% include '@components/form/form.twig' with {
            attributes: {
              action: searchfield.action,
              "aria-label": label,
              "data-search": "true",
            },
            fieldsets: [{
              fields: [{
                type: "search",
                placeholder: searchfield.input.placeholder,
                name: searchfield.input.name,
                id: searchfield.input.id,
              }]
            }]
          }
          %}
				{% endblock %}
			</div>
		</div>
		<!-- /.ilo--search-box -->
	</div>
	<!-- /.ilo--header--navigation -->
</header>
