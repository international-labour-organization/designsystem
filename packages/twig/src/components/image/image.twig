{#
  IMAGE COMPONENT
#}
{% set theme = theme|default("light") %}
<figure class="ilo--image ilo--image__theme__{{theme}}">
  <div class="image ilo--image--wrapper">
    <picture {% if credit and ishero and ishero != 'false' %}title="{{credit}}"{% endif %}>
      {% for img in url|reverse %}
        {% if loop.last == false  %}
          {% if img.breakpoint matches '/^\\d+$/' %}
            <source srcset="{{img.src}}" media="(min-width: {{img.breakpoint}}px)">
          {% else %}
            <source srcset="{{img.src}}" media="{{img.breakpoint}}">
          {% endif %}
        {% endif %}
      {% endfor %}
      <img src="{{url|reverse|last.src}}" alt="{{alt}}" {% if loading %}loading="{{ loading }}"{% endif %}>
    </picture>
    {% if not ishero or ishero =='false' %}
      {% if credit %}
      <div class="ilo--image--credit">
        <div class="ilo--image--tooltip">
          {% include '@components/tooltip/tooltip.twig' with {
              label: credit,
              icon: true,
              theme: theme,
              icontheme: theme == 'dark' ? 'light' : 'dark'
            } only %}
        </div>
        <div class="ilo--image--label">
          {{credit}}
        </div>
      </div>
      {% endif %}
    {% endif %}
  </div>
  {% if caption %}
    <figcaption>{{caption}}</figcaption>
  {% endif %}
</figure>
